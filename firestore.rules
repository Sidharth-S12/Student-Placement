rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if caller matches UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. Users Collection (Primary Identity & Role Store)
    // =========================================================================
    // Rules:
    // - Authenticated users can read their own role document.
    // - On registration, users can create their own document with role 'student' or 'company'.
    // - Role cannot be self-escalated or modified through client updates.
    // - Admins are managed via backend Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && (request.resource.data.role in ['student', 'company'])
                    && request.resource.data.uid == userId;
      allow update: if isOwner(userId) 
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // =========================================================================
    // 2. Student Placement Profiles
    // =========================================================================
    // Rules:
    // - Students can read and write only their own profile.
    // - Authenticated recruiters/admins can read candidate profiles.
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(studentId);
    }

    // =========================================================================
    // 3. Company Profiles
    // =========================================================================
    // Rules:
    // - Companies can read and write only their own company profile.
    // - Authenticated users can read company info.
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(companyId);
    }

    // =========================================================================
    // 4. Technical Skill Assessments
    // =========================================================================
    // Rules:
    // - Students can read and create their own assessments.
    // - Authenticated placement officers/recruiters can read assessment results.
    match /technicalAssessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                    && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // 5. Aptitude Assessments
    // =========================================================================
    match /aptitudeAssessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                    && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}

# Groq API Key (REQUIRED for dynamic runtime question generation)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Recommended: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile
# Groq Vision Model (for AI Appearance & Dress Code Analyzer)
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Optional Alternate Vision AI Providers
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Backend Server Port
PORT=5000

# Firebase Service Account (Optional: Live Firestore connection)
# Leave empty for automatic local development store emulation
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

# External Machine Learning Service URL (Optional)
# If empty, transparently delegates to predictDifficultyFallback()
ML_DIFFICULTY_SERVICE_URL=
